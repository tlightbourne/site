# Where the request-a-job form sends submissions.
# Formspree:  https://formspree.io/f/your-form-id
# Web3Forms:  https://api.web3forms.com/submit  (also set VITE_FORM_ACCESS_KEY)
VITE_FORM_ENDPOINT=

# Only needed for services that use an access key in the form body (e.g. Web3Forms).
VITE_FORM_ACCESS_KEY=
